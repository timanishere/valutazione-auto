car_make_tbl
-
make_id PK int
make varchar(200)


car_model_tbl
-
model_id PK int
model varchar(200)


car_year_tbl
-
year_id PK int
year int


car_colour_tbl
-
colour_id PK int
colour varchar(200)


car_gear_tbl
-
gear_id PK int
gear varchar(200)


car_fuel_type_tbl
-
fuel_type_id PK int
fuel_type varchar(200)


car_prices_tbl
- 
price_id PK int
make_id int FK >- car_make_tbl.make_id
model_id int FK >- car_model_tbl.model_id
year_id int FK >- car_year_tbl.year_id
colour_id int FK >- car_colour_tbl.colour_id
gear_id int FK >- car_gear_tbl.gear_id
fuel_type_id int FK >- car_fuel_type_tbl.fuel_type_id
km varchar(200)
km_range varchar(200)
kw varchar(200)
price varchar(200)